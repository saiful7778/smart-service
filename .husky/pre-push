#!/usr/bin/env bash
set -e

# Resolve the base ref to diff against so we only check packages touched by this push.
# stdin format: <local ref> <local sha> <remote ref> <remote sha>
remote_ref=""
remote_sha=""
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
  remote_ref="$_remote_ref"
  remote_sha="$_remote_sha"
  break
done

base=""

# Prefer the remote branch's current SHA (already on the remote). This scopes the
# checks to exactly the packages affected by the commits being pushed.
if [ -n "$remote_sha" ] && [ "$remote_sha" != "$(printf '0%.0s' {1..40})" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
  base="$remote_sha"
else
  # New branch / unknown base: fall back to a local tracking ref for the branch,
  # then the trunk (in case the local refs are stale, this is conservative).
  for candidate in "origin/${remote_ref#refs/heads/}" origin/main origin/dev; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
      base="$candidate"
      break
    fi
  done
fi

if [ -z "$base" ]; then
  echo "pre-push: could not determine a base ref; running full checks"
  pnpm typecheck && pnpm lint && pnpm test
  exit $?
fi

echo "pre-push: running typecheck, lint and test for packages changed vs $base"
for task in typecheck lint test; do
  pnpm exec turbo "$task" --filter="...[${base}]"
done