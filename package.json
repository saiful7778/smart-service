{
  "name": "smart_service",
  "version": "0.0.1",
  "private": true,
  "author": "Saiful Islam <saiful.islam.rafi.88@gmail.com>",
  "contributors": [
    {
      "name": "Saiful Islam",
      "email": "saiful.islam.rafi.88@gmail.com"
    }
  ],
  "license": "PROPRIETARY",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "seed:storage": "tsx scripts/seed/storage.seed.ts",
    "test": "turbo test",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "docker:dev:up": "bash scripts/docker-compose-wrapper.sh -f ./infra/docker/docker-compose-dev.yml up -d",
    "docker:dev:down": "bash scripts/docker-compose-wrapper.sh -f ./infra/docker/docker-compose-dev.yml down",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@storybook/addon-vitest": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@vitest/browser-playwright": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "catalog:",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "overrides": {
      "next": ">=16.2.11",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "fast-uri": ">=3.1.5",
      "socket.io-parser": ">=4.2.7",
      "undici": ">=7.29.0",
      "brace-expansion": "2.1.4",
      "ip-address": ">=10.3.1",
      "esbuild": "^0.25.12",
      "@eslint/plugin-kit": "^0.3.4"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "sharp",
      "unrs-resolver"
    ]
  }
}
