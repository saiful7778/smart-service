  created_by uuid
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    organization_id [name: 'job_categories_organization_id_idx']
    created_by [name: 'job_categories_created_by_idx']
    slug [name: 'job_categories_slug_unique', unique]
    (organization_id, slug) [name: 'job_categories_organization_id_slug_unique', unique]
    created_at [name: 'job_categories_created_at_idx']
  }
}

table job_category_joins {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  job_id uuid [not null]
  job_category_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    job_id [name: 'job_category_join_job_id_idx']
    job_category_id [name: 'job_category_join_job_category_id_idx']
    (job_id, job_category_id) [name: 'job_category_join_unique', unique]
  }
}

