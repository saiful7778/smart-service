enum ActionTypeEnum {
  create
  read
  list
  update
  delete
  manage
  export
}

enum ContactSubmissionStatusEnum {
  PENDING
  READ
  REPLIED
  SPAM
}

enum FeedbackIssueStatusEnum {
  OPEN
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum FeedbackIssueTypeEnum {
  BUG
  FEATURE_REQUEST
  FEEDBACK
  SUGGESTION
  REPORT
  OTHER
}

enum JobAssignmentRoleEnum {
  primary
  secondary
  supervisor
  trainee
}

enum JobAssignmentStatusEnum {
  active
  completed
  cancelled
  pending
  declined
}

enum JobStatusEnum {
  draft
  scheduled
  in_progress
  on_hold
  needs_review
  completed
  cancelled
}

enum LeadEstimateStatusEnum {
  draft
  sent
  viewed
  accepted
  declined
  expired
}

enum LeadRevenueTypeEnum {
  expected
  invoiced
  received
}

enum LeadSourceEnum {
  manual
  webhook
  iframe
}

enum LeadStatusEnum {
  new
  contacted
  qualified
  nurture
  converted
  lost
  cancelled
  disqualified
}

enum NotificationCategoryEnum {
  SYSTEM
  ORG
  AUTH
  SUPPORT
  CUSTOMER
  LEAD
  JOB
  INVOICE
  PAYMENT
  BILLING
  REPORT
  SCHEDULE
}

enum NotificationLevelEnum {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum PermissionLevelEnum {
  system
  org
  self
}

enum ResourceTypeEnum {
  user
  role
  permission
  org
  invitation
  material
  team
  team_member
  customer
  lead
  lead_category
  lead_attachment
  lead_note
  lead_invoice
  lead_payment
  lead_billing
  lead_report
  lead_estimate
  job
  job_category
  job_material
  job_assignment
  job_attachment
  job_note
  job_revenue
  job_invoice
  job_payment
  job_estimate
  job_billing
  job_time_entry
  invoice
  payment
  billing
  report
  schedule
  feedback
}

enum RoleEnum {
  MEMBER
  STAFF
  DISPATCHER
  TEAM_LEAD
  MANAGER
  ORG_SUPPORT_AGENT
  ORG_ADMIN
  OWNER
  USER
  SYSTEM_SUPPORT_AGENT
  SYSTEM_ADMIN
  SUPER_ADMIN
}

enum RoleTypeEnum {
  SYSTEM
  ORG
}

table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  email varchar(255) [not null]
  email_verified boolean [not null, default: false]
  image varchar(255)
  role varchar(255)
  banned boolean [default: false]
  ban_reason varchar(255)
  ban_expires "timestamp (3) with time zone"
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'user_email_key', unique]
  }
}

table user_activities {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  session_id uuid
  ip_address varchar(45)
  user_agent text
  login_at "timestamp (3) with time zone" [not null, default: `now()`]
  logout_at "timestamp (3) with time zone"
  last_seen_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    user_id [name: 'user_activity_user_id_idx']
    login_at [name: 'user_activity_login_at_idx']
    last_seen_at [name: 'session_activity_last_seen_at_idx']
  }
}

table user_settings {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  timezone varchar(50) [not null, default: 'UTC']
  locale varchar(10) [not null, default: 'en-US']
  currency varchar(3) [default: 'USD']
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    user_id [name: 'user_settings_user_id_idx', unique]
  }
}

table accounts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  account_id text [not null]
  provider_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at "timestamp (6) with time zone"
  refresh_token_expires_at "timestamp (6) with time zone"
  scope text
  password text
  user_id uuid [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    (provider_id, account_id) [name: 'account_provider_account_id_key', unique]
    user_id [name: 'account_user_id_idx']
  }
}

table files {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  key varchar(512) [not null]
  filename varchar(255) [not null]
  original_name varchar(255) [not null]
  mime_type varchar(127) [not null]
  size bigint [not null]
  uploaded_by uuid
  entity_type varchar(50)
  entity_id uuid
  uploaded_at "timestamp (3) with time zone" [not null, default: `now()`]
  deleted_at "timestamp (3) with time zone"
  deleted_by uuid

  indexes {
    
    
    uploaded_by [name: 'files_user_idx']
    deleted_by [name: 'files_deleted_by_idx']
    (entity_type, entity_id) [name: 'files_entity_idx']
    key [name: 'files_key_idx']
    uploaded_at [name: 'files_uploaded_at_idx']
  }
}

table verifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identifier text [not null]
  value text [not null]
  expires_at "timestamp (3) with time zone" [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]
}

table sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  token text [not null]
  ip_address varchar(45)
  user_agent text
  impersonated_by varchar(255)
  user_id uuid [not null]
  active_org_id uuid
  active_team_id uuid
  expires_at "timestamp (6) with time zone" [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    token [name: 'session_token_key', unique]
    active_org_id [name: 'session_active_org_id_idx']
    user_id [name: 'session_user_id_idx']
    expires_at [name: 'session_expires_at_idx']
  }
}

table addresses {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  line1 varchar(255) [not null]
  line2 varchar(255)
  city varchar(100) [not null]
  state varchar(100) [not null]
  zip_code varchar(20) [not null]
  country varchar(100) [not null, default: 'US']
  latitude "numeric(11, 8)"
  longitude "numeric(11, 8)"
  place_id varchar(255)
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]
  deleted_at "timestamp (3) with time zone"
  deleted_by uuid

  indexes {
    
    city [name: 'address_city_idx']
    state [name: 'address_state_idx']
    zip_code [name: 'address_zip_code_idx']
    country [name: 'address_country_idx']
    (latitude, longitude) [name: 'address_coordinates_idx']
    created_at [name: 'address_created_at_idx']
    deleted_at [name: 'address_deleted_at_idx']
    deleted_by [name: 'address_deleted_by_idx']
  }
}

table user_addresses {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  address_id uuid [not null]
  address_type varchar
  created_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    user_id [name: 'user_address_user_id_idx']
    address_id [name: 'user_address_address_id_idx']
  }
}

table org_addresses {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  address_id uuid [not null]
  is_primary boolean [default: false]
  address_type varchar
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    organization_id [name: 'org_address_org_id_idx']
    address_id [name: 'org_address_address_id_idx']
    is_primary [name: 'org_address_is_primary_idx']
  }
}

table customer_addresses {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  customer_id uuid [not null]
  address_id uuid [not null]
  address_type varchar(255) [not null]
  is_primary boolean [not null, default: false]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    customer_id [name: 'customerAddress_customer_id_idx']
