  }
}

table contact_submissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  email varchar(255) [not null]
  subject varchar(255) [not null]
  phone varchar(50)
  company varchar(255)
  message text [not null]
  status ContactSubmissionStatusEnum [not null, default: 'PENDING']
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'contact_submission_email_idx']
    status [name: 'contact_submission_status_idx']
    created_at [name: 'contact_submission_created_at_idx']
  }
}

table contact_submission_replies {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  submission_id uuid [not null]
  replied_by uuid [not null]
  reply text [not null]
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    submission_id [name: 'contact_submission_reply_submission_id_idx']
    replied_by [name: 'contact_submission_reply_replied_by_idx']
  }
}

table customers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(255) [not null]
  email varchar(255)
  phone varchar(50)
  company varchar(255)
  notes text
  source varchar(100)
  metadata jsonb
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at "timestamp (3) with time zone"
  deleted_by uuid

  indexes {
    
    
    
    
    organization_id [name: 'customer_org_id_idx']
    created_at [name: 'customer_created_at_idx']
    created_by [name: 'customer_created_by_idx']
    updated_by [name: 'customer_updated_by_idx']
    deleted_by [name: 'customer_deleted_by_idx']
    deleted_at [name: 'customer_deleted_at_idx']
  }
}

table jobs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  customer_id uuid
  lead_id uuid
  title varchar(255) [not null]
  description text
  status JobStatusEnum [not null, default: 'scheduled']
  expected_revenue "numeric(10, 2)" [default: '0']
  invoiced_revenue "numeric(10, 2)" [default: '0']
  received_revenue "numeric(10, 2)" [default: '0']
  created_by uuid
  updated_by uuid
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]
  deleted_at "timestamp (3) with time zone"
  deleted_by uuid

  indexes {
    
    
    
    
    
    
    organization_id [name: 'jobs_org_id_idx']
    lead_id [name: 'jobs_lead_id_idx']
    customer_id [name: 'jobs_customer_id_idx']
    status [name: 'jobs_status_idx']
    created_at [name: 'jobs_created_at_idx']
    created_by [name: 'jobs_created_by_idx']
    updated_by [name: 'jobs_updated_by_idx']
    deleted_by [name: 'jobs_deleted_by_idx']
    deleted_at [name: 'jobs_deleted_at_idx']
  }
}

