  status JobAssignmentStatusEnum [not null, default: 'pending']
  acknowledge_at "timestamp (3) with time zone"
  created_at "timestamp (3) with time zone" [not null, default: `now()`]
  updated_at "timestamp (3) with time zone" [not null, default: `now()`]

  indexes {
    
    
    
    job_schedule_id [name: 'job_schedule_assignement_schedule_id_idx']
    assigned_to [name: 'job_schedule_assignement_assignedTo_idx']
    assigned_by [name: 'job_schedule_assignement_assignedBy_idx']
    status [name: 'job_schedule_assignement_status_idx']
    role [name: 'job_schedule_assignement_role_idx']
    acknowledge_at [name: 'job_schedule_assignement_acknowledgeAt_idx']
    created_at [name: 'job_schedule_assignement_created_at_idx']
  }
}

