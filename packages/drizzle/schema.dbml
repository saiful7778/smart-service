    job_id [name: 'job_material_job_id_idx']
    material_id [name: 'job_material_material_id_idx']
    created_by [name: 'job_material_created_by_idx']
    updated_by [name: 'job_material_updated_by_idx']
    quantity [name: 'job_material_quantity_idx']
    created_at [name: 'job_material_created_at_idx']
  }
}

table job_schedules {
